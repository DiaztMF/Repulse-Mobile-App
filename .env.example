# Firebase web config. Copy to .env.local and fill from
# Project settings → Your apps → Web app.
# With none of these set the app runs on synthetic data.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Realtime Database, for the 1 Hz live node only.
VITE_FB_DATABASE_URL=
