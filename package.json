{
  "name": "repulse-mobile-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:data": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/data/mock.check.ts",
    "check:gate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/lib/fitGate.check.ts",
    "check:copy": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/lib/copy.check.ts",
    "check:codec": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/ble/codec.check.ts",
    "check:ble": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/ble/mock.check.ts",
    "check:machine": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/state/machine.check.ts",
    "check:sos": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/lib/sos.check.ts",
    "check:screening": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/lib/screening.check.ts",
    "check:native": "cd android && gradlew assembleDebug",
    "splash": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/splash.ts",
    "check": "npm run check:data && npm run check:gate && npm run check:copy && npm run check:ble && npm run check:codec && npm run check:machine && npm run check:screening && npm run check:sos",
    "dev:tunnel": "vite --mode tunnel"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@capawesome-team/capacitor-android-battery-optimization": "^7.0.0",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "repulse-monitor": "file:plugins/repulse-monitor",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
