<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Merged into the app's manifest at build time, which is the point of
         keeping this plugin outside android/: that folder is gitignored, so
         anything declared there is lost on the next clone. -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 10 and up refuse a location request made from the
         background unless a foreground service is running that declares
         the location type. Without this the SOS follow-up fix never
         arrives, and nothing in the log says why. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 14+ treats connectedDevice as a claim it verifies, not a
         label: the service is refused unless the app actually holds one of
         the device-connection permissions. These are the ones this app will
         use for real the moment BLE lands, so the claim is honest today and
         true tomorrow.

         neverForLocation: scan results are never used to infer position,
         and saying so keeps the location prompt out of the way. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- minSdkVersion is 23, and a real budget Redmi in the field can still
         be on Android 11 or below, where BLUETOOTH_CONNECT/SCAN above do
         not exist as permissions at all — the scan would return nothing,
         silently, on exactly the phone this app most needs to work on.
         Normal-level, granted at install, no dialog. ACCESS_FINE_LOCATION
         is what actually gates scan results pre-12, and it is already
         requested at O3 regardless of Android version. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Location is NOT capped here any more.
         It used to be declared with maxSdkVersion="30" and tools:node="replace",
         to keep the BLE plugin's unbounded version out of the permission list
         of a product that watches people sleep. That cap silently removed the
         permission on every Android 12 and newer phone, which is every phone
         this runs on, and the SOS message went out saying the location was
         unavailable. SOS needs a real fix, so the permission is real.

         BLUETOOTH_SCAN keeps neverForLocation regardless: scan results are
         still never used to infer position. -->

    <!-- Android 14+ requires this to put a notification in front of a
         locked screen. Without it the alert becomes an ordinary heads-up
         banner that a sleeping person will never see. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The emergency message leaves the phone by itself. SMS is the only
         channel on Android an app may send on without a person tapping
         Send, and the client asked for exactly that: nobody should have to
         find a Send button during a medical emergency. Play Store
         distribution needs a declaration form for this permission; a
         sideloaded build does not. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application>
        <!-- connectedDevice, not dataSync: dataSync is capped at six hours
             in any 24 on Android 15, and this service has to last a night
             and then the next one. The type is honest either way — it
             exists to hold a link to the band. -->
        <service
            android:name="id.repulse.monitor.MonitorService"
            android:foregroundServiceType="connectedDevice|location"
            android:exported="false" />
    </application>

</manifest>
