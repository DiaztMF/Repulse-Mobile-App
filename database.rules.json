{
  "rules": {
    "live": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('viewers/' + $uid + '/' + auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "viewers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
