{
  "firestore": { "rules": "firestore.rules" },
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "site": "repulse",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
